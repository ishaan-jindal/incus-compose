name: with-ports
services:
  web:
    image: docker.io/alpine:edge
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "8080"
        protocol: tcp
    x-incus:
      limits.cpu: 1
  web-nat:
    image: docker.io/alpine:edge
    networks:
      default: null
    ports:
      - mode: ingress
        target: 80
        published: "8081"
        protocol: tcp
        x-incus-compose:
          nat: true
    x-incus:
      limits.cpu: 1
networks:
  default:
    name: with-ports_default
