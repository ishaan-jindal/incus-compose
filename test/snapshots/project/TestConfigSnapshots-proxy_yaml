name: proxy
services:
  backend1:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    image: docker.io/library/caddy:2-alpine
    networks:
      default: null
    restart: unless-stopped
    x-incus:
      limits.cpu: 1
  backend2:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    image: docker.io/library/caddy:2-alpine
    networks:
      default: null
    restart: unless-stopped
    x-incus:
      limits.cpu: 1
  frontend:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    depends_on:
      backend1:
        condition: service_healthy
        required: true
      backend2:
        condition: service_healthy
        required: true
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    image: docker.io/library/caddy:2-alpine
    networks:
      default: null
    restart: unless-stopped
    x-incus:
      limits.cpu: 1
networks:
  default:
    name: proxy_default
configs:
  caddyfile:
    name: proxy_caddyfile
    file: $FIXTURE_PATH/Caddyfile
