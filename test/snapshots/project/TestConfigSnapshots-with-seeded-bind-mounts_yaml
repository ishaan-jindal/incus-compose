name: with-seeded-bind-mounts
services:
  dir-web:
    command:
      - -c
      - httpd -f -v -p 8080 -h /www
    image: docker.io/library/busybox:glibc
    networks:
      default: null
    volumes:
      - type: bind
        source: $FIXTURE_PATH/html
        target: /www
        read_only: true
        x-incus-compose:
          seed: true
    x-incus:
      limits.cpu: 1
  file-web:
    command:
      - -c
      - httpd -f -v -p 8080 -h /www
    image: docker.io/library/busybox:glibc
    networks:
      default: null
    volumes:
      - type: bind
        source: $FIXTURE_PATH/file.html
        target: /www/index.html
        read_only: true
        x-incus-compose:
          seed: true
    x-incus:
      limits.cpu: 1
networks:
  default:
    name: with-seeded-bind-mounts_default
