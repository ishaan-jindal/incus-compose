name: with-bind-mounts
services:
  dir-web:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    image: docker.io/library/caddy:2-alpine
    networks:
      default: null
    volumes:
      - type: bind
        source: $FIXTURE_PATH/html
        target: /usr/share/caddy
        read_only: true
        bind: {}
    x-incus:
      limits.cpu: 1
  file-web:
    configs:
      - source: caddyfile
        target: /etc/caddy/Caddyfile
    image: docker.io/library/caddy:2-alpine
    networks:
      default: null
    volumes:
      - type: bind
        source: $FIXTURE_PATH/file.html
        target: /usr/share/caddy/index.html
        read_only: true
        bind: {}
    x-incus:
      limits.cpu: 1
networks:
  default:
    name: with-bind-mounts_default
configs:
  caddyfile:
    name: with-bind-mounts_caddyfile
    file: $FIXTURE_PATH/Caddyfile
